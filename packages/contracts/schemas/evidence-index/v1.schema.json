{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchrally.dev/evidence-index/v1",
  "title": "LaunchRally Evidence Index v1",
  "type": "object",
  "required": ["schema_version", "index_id", "report_id", "created_at", "entries"],
  "properties": {
    "schema_version": { "const": "launchrally.dev/evidence-index/v1" },
    "index_id": { "type": "string", "minLength": 1 },
    "report_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["digest", "evidence_kind", "source", "target", "collected_at", "freshness_class", "redaction_state", "normalized_artifact"],
        "properties": {
          "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "evidence_kind": { "enum": ["file", "release_intent", "project_fact", "public_observation", "machine_evidence"] },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "collected_at": { "type": "string", "format": "date-time" },
          "freshness_class": { "enum": ["audit_time", "repository_snapshot", "confirmed_scope"] },
          "redaction_state": { "enum": ["normalized", "allowlisted", "metadata_only"] },
          "normalized_artifact": { "type": "object" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
