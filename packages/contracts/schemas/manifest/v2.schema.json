{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchrally.dev/manifest/v2",
  "title": "LaunchRally Manifest v2",
  "type": "object",
  "required": ["schema_version", "project", "release", "execution", "support", "providers"],
  "properties": {
    "schema_version": { "const": "launchrally.dev/manifest/v2" },
    "project": {
      "type": "object",
      "required": ["name", "type", "package_manager"],
      "properties": {
        "name": { "$ref": "#/$defs/intentState" },
        "type": { "$ref": "#/$defs/intentState" },
        "package_manager": { "$ref": "#/$defs/intentState" }
      },
      "additionalProperties": false
    },
    "release": {
      "type": "object",
      "required": ["intended_environment", "production_targets", "core_journeys"],
      "properties": {
        "intended_environment": { "$ref": "#/$defs/intentState" },
        "production_targets": {
          "description": "Compatibility field containing the confirmed public targets for the intended environment.",
          "$ref": "#/$defs/intentState"
        },
        "core_journeys": { "$ref": "#/$defs/journeyIntentState" }
      },
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["source_report_id", "assessment", "public_verification"],
      "properties": {
        "source_report_id": { "$ref": "#/$defs/intentState" },
        "assessment": { "$ref": "#/$defs/intentState" },
        "public_verification": { "$ref": "#/$defs/intentState" }
      },
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "required": ["layers"],
      "properties": {
        "layers": { "$ref": "#/$defs/intentState" }
      },
      "additionalProperties": false
    },
    "providers": {
      "type": "object",
      "required": ["roles"],
      "properties": {
        "roles": { "$ref": "#/$defs/intentState" },
        "decision": { "$ref": "#/$defs/providerDecision" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "intentState": {
      "oneOf": [
        { "$ref": "#/$defs/declaredState" },
        { "$ref": "#/$defs/unknownState" },
        { "$ref": "#/$defs/notApplicableState" }
      ]
    },
    "journeyIntentState": {
      "oneOf": [
        {
          "type": "object",
          "required": ["state", "value"],
          "properties": {
            "state": { "const": "declared" },
            "value": {
              "type": "array",
              "items": {
                "oneOf": [
                  { "type": "string", "minLength": 1 },
                  { "$ref": "#/$defs/publicJourney" },
                  { "$ref": "#/$defs/protectedJourney" }
                ]
              }
            }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/unknownState" },
        { "$ref": "#/$defs/notApplicableState" }
      ]
    },
    "publicJourney": {
      "type": "object",
      "required": ["purpose", "path", "method"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^/(?!/)" },
        "method": { "const": "GET" }
      },
      "additionalProperties": false
    },
    "legacyJourney": {
      "description": "Compatibility shape for v2 journey objects published before protected journey contracts; versioned objects are excluded and remain fail-closed.",
      "type": "object",
      "not": { "required": ["schema_version"] }
    },
    "protectedJourney": {
      "type": "object",
      "required": ["schema_version", "purpose", "path", "method", "access"],
      "properties": {
        "schema_version": { "const": "launchrally.dev/protected-journey/v1" },
        "purpose": { "const": "authenticated Core Journey" },
        "path": { "type": "string", "pattern": "^/(?:account|accounts|admin|api|app|authorize|billing|checkout|control|dashboard|files|guardian|health|home|inbox|me|orders|organization|organizations|portal|private|profile|protected|session|settings|staff|status|team|teams|uploads|user|users|v1|v2|v3|workspace|workspaces)(?:/(?:account|accounts|admin|api|app|authorize|billing|checkout|control|dashboard|files|guardian|health|home|inbox|me|orders|organization|organizations|portal|private|profile|protected|session|settings|staff|status|team|teams|uploads|user|users|v1|v2|v3|workspace|workspaces))*$" },
        "method": { "const": "GET" },
        "access": {
          "type": "object",
          "required": ["authentication_class", "authenticated_status_codes"],
          "properties": {
            "authentication_class": { "enum": ["user", "staff", "signed_token"] },
            "anonymous_status_codes": { "type": "array", "items": { "type": "integer", "minimum": 300, "maximum": 499 }, "minItems": 1, "maxItems": 10, "uniqueItems": true },
            "authenticated_status_codes": { "type": "array", "items": { "type": "integer", "minimum": 200, "maximum": 299 }, "minItems": 1, "maxItems": 10, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "declaredState": {
      "type": "object",
      "required": ["state", "value"],
      "properties": {
        "state": { "const": "declared" },
        "value": {}
      },
      "additionalProperties": false
    },
    "unknownState": {
      "type": "object",
      "required": ["state", "reason"],
      "properties": {
        "state": { "const": "unknown" },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "notApplicableState": {
      "type": "object",
      "required": ["state", "reason", "evidence"],
      "properties": {
        "state": { "const": "not_applicable" },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/intentEvidence" }
        }
      },
      "additionalProperties": false
    },
    "intentEvidence": {
      "type": "object",
      "required": ["source_report_id", "field"],
      "properties": {
        "source_report_id": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" }
      },
      "additionalProperties": false
    },
    "providerDecision": {
      "type": "object",
      "required": ["schema_version", "source_report_id", "card_id", "card_version", "capability_id", "provider", "role", "confirmed"],
      "properties": {
        "schema_version": { "const": "launchrally.dev/provider-intent-decision/v1" },
        "source_report_id": { "type": "string", "minLength": 1 },
        "card_id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "card_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "capability_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "provider": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "role": { "type": "string", "minLength": 1 },
        "confirmed": { "const": true },
        "knowledge_ref": {
          "type": "object",
          "required": ["id", "schema_version", "digest"],
          "properties": {
            "id": { "type": "string", "pattern": "^knowledge_[a-f0-9]{24}$" },
            "schema_version": { "const": "launchrally.dev/provider-knowledge/v1" },
            "digest": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "x-launchrally-contract-major": 2,
  "x-launchrally-status": "current"
}
