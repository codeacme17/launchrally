{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchrally.dev/report/v1",
  "title": "LaunchRally Report Record v1",
  "type": "object",
  "required": ["schema_version", "report_id", "assessment", "provenance", "scope", "catalog", "results", "limitations"],
  "properties": {
    "schema_version": { "const": "launchrally.dev/report/v1" },
    "report_id": { "type": "string", "minLength": 1 },
    "assessment": {
      "enum": ["launch_ready", "ready_with_warnings", "no_go", "inconclusive"]
    },
    "provenance": {
      "type": "object",
      "required": ["cli_version", "check_catalog_version", "baseline_version", "active_profile_versions", "active_adapter_versions", "scan_policy_version"],
      "properties": {
        "cli_version": { "type": "string", "minLength": 1 },
        "check_catalog_version": { "type": "string", "minLength": 1 },
        "baseline_version": { "type": "string", "minLength": 1 },
        "active_profile_versions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "active_adapter_versions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "scan_policy_version": { "const": "local_safe_scan/v1" }
      },
      "additionalProperties": false
    },
    "catalog": { "$ref": "#/$defs/catalog" },
    "scope": {
      "type": "object",
      "required": ["project_root", "project_type", "access", "public_verification", "excluded"],
      "properties": {
        "project_root": { "type": "string", "minLength": 1 },
        "project_type": { "type": "string", "minLength": 1 },
        "access": { "enum": ["local_read_only", "local_and_public_read_only"] },
        "public_verification": {
          "type": "object",
          "required": ["decision", "targets", "probe_ids"],
          "properties": {
            "decision": { "enum": ["approved", "denied"] },
            "targets": { "type": "array", "items": { "type": "string", "format": "uri" }, "uniqueItems": true },
            "probe_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "excluded": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "results": {
      "type": "object",
      "required": ["checks", "public_evidence", "action_queue", "verification_gaps", "domain_coverage", "coverage_summary"],
      "properties": {
        "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } },
        "public_evidence": {
          "type": "array",
          "items": { "$ref": "#/$defs/publicObservation" }
        },
        "action_queue": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "verification_gaps": {
          "type": "array",
          "items": { "$ref": "#/$defs/verificationGap" }
        },
        "domain_coverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/domainCoverage" },
          "minItems": 8,
          "maxItems": 8
        },
        "coverage_summary": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverageSummary" }
        }
      },
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    }
  },
  "additionalProperties": true,
  "$defs": {
    "priority": { "enum": ["p0", "p1", "p2"] },
    "riskDomain": {
      "enum": ["build_integrity", "configuration", "deployment", "availability", "security_and_privacy", "data_and_integrations", "observability_and_operations", "user_experience"]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "path"],
          "properties": {
            "kind": { "const": "file" },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "field", "value"],
          "properties": {
            "kind": { "const": "release_intent" },
            "field": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "field", "value"],
          "properties": {
            "kind": { "const": "project_fact" },
            "field": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/publicObservation" }
      ]
    },
    "publicObservation": {
      "type": "object",
      "required": ["kind", "probe_id", "probe_kind", "target", "host", "port", "path", "method", "purpose", "status", "outcome", "collected_at", "duration_ms", "details", "provenance"],
      "properties": {
        "kind": { "const": "public_observation" },
        "probe_id": { "type": "string", "minLength": 1 },
        "probe_kind": { "enum": ["dns", "tls", "http", "health", "journey"] },
        "target": { "type": "string", "format": "uri" },
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "pattern": "^/" },
        "method": { "enum": ["DNS_LOOKUP", "TLS_HANDSHAKE", "GET"] },
        "purpose": { "type": "string", "minLength": 1 },
        "verification_mode": { "enum": ["description_only", "executable_path"] },
        "status": { "enum": ["passed", "failed", "unverified"] },
        "outcome": { "enum": ["resolved", "secure", "reachable", "healthy", "completed", "journey_definition_incomplete", "redirect_not_followed", "target_mismatch", "http_status_failure", "dns_failure", "certificate_failure", "unreachable", "timeout", "execution_failure"] },
        "collected_at": { "type": "string", "format": "date-time" },
        "duration_ms": { "type": "integer", "minimum": 0 },
        "details": { "type": "object" },
        "provenance": {
          "type": "object",
          "required": ["collector", "exact_target", "collected_at"],
          "properties": {
            "collector": { "const": "public-verification/v1" },
            "exact_target": { "type": "string", "format": "uri" },
            "collected_at": { "type": "string", "format": "date-time" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "check": {
      "type": "object",
      "required": ["check_id", "check_version", "risk_domain", "priority", "severity", "release_gate", "applicability", "status", "summary", "evidence"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "check_version": { "type": "integer", "minimum": 1 },
        "risk_domain": { "$ref": "#/$defs/riskDomain" },
        "priority": { "$ref": "#/$defs/priority" },
        "severity": { "enum": ["critical", "major", "moderate"] },
        "release_gate": { "enum": ["always", "policy", "never"] },
        "applicability": { "$ref": "#/$defs/applicabilityResult" },
        "status": { "enum": ["passed", "failed", "unverified", "not_applicable"] },
        "summary": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "required": ["check_id", "priority", "action"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "priority": { "$ref": "#/$defs/priority" },
        "action": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "verificationGap": {
      "type": "object",
      "required": ["check_id", "risk_domain", "priority", "status", "reason_code", "reason"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "risk_domain": { "$ref": "#/$defs/riskDomain" },
        "priority": { "$ref": "#/$defs/priority" },
        "status": { "const": "unverified" },
        "reason_code": { "enum": ["permission_denied", "missing_required_input", "conflicting_evidence", "applicability_unresolved", "execution_failure", "execution_skipped", "specialist_support_unavailable", "partial_public_evidence"] },
        "reason": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "coverageSummary": {
      "type": "object",
      "required": ["priority", "applicable_checks", "executed_checks", "passed_checks", "failed_checks", "not_applicable_checks", "verification_gaps", "coverage"],
      "properties": {
        "priority": { "$ref": "#/$defs/priority" },
        "applicable_checks": { "type": "integer", "minimum": 0 },
        "executed_checks": { "type": "integer", "minimum": 0 },
        "passed_checks": { "type": "integer", "minimum": 0 },
        "failed_checks": { "type": "integer", "minimum": 0 },
        "not_applicable_checks": { "type": "integer", "minimum": 0 },
        "verification_gaps": { "type": "integer", "minimum": 0 },
        "coverage": { "enum": ["complete", "partial", "none"] }
      },
      "additionalProperties": false
    },
    "applicabilityResult": {
      "type": "object",
      "required": ["status", "reason", "evidence"],
      "properties": {
        "status": { "enum": ["applicable", "not_applicable", "unverified"] },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
      },
      "additionalProperties": false
    },
    "catalog": {
      "type": "object",
      "required": ["versions", "risk_domains", "checks"],
      "properties": {
        "versions": {
          "type": "object",
          "required": ["check_catalog", "baseline", "active_profiles", "active_adapters"],
          "properties": {
            "check_catalog": { "type": "string", "minLength": 1 },
            "baseline": { "type": "string", "minLength": 1 },
            "active_profiles": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
            "active_adapters": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
          },
          "additionalProperties": false
        },
        "risk_domains": {
          "type": "array",
          "items": { "$ref": "#/$defs/riskDomain" },
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true
        },
        "checks": {
          "type": "array",
          "items": { "$ref": "#/$defs/checkDeclaration" },
          "minItems": 8
        }
      },
      "additionalProperties": false
    },
    "checkDeclaration": {
      "type": "object",
      "required": ["check_id", "check_version", "risk_domain", "permission_id", "applicability", "required_inputs", "evidence_requirement", "verification_rules", "severity_policy", "release_gate_policy", "freshness_behavior"],
      "properties": {
        "check_id": { "type": "string", "minLength": 1 },
        "check_version": { "type": "integer", "minimum": 1 },
        "risk_domain": { "$ref": "#/$defs/riskDomain" },
        "permission_id": { "type": "string", "minLength": 1 },
        "applicability": { "$ref": "#/$defs/applicabilityDeclaration" },
        "required_inputs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "evidence_requirement": { "$ref": "#/$defs/evidenceRequirement" },
        "verification_rules": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "severity_policy": { "$ref": "#/$defs/severityPolicy" },
        "release_gate_policy": { "$ref": "#/$defs/releaseGatePolicy" },
        "freshness_behavior": { "$ref": "#/$defs/freshnessBehavior" }
      },
      "additionalProperties": false
    },
    "applicabilityDeclaration": {
      "type": "object",
      "required": ["rule", "required_evidence"],
      "properties": {
        "rule": { "type": "string", "minLength": 1 },
        "required_evidence": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "evidenceRequirement": {
      "type": "object",
      "required": ["accepted_kinds", "minimum_items", "provenance_required"],
      "properties": {
        "accepted_kinds": { "type": "array", "items": { "enum": ["file", "project_fact", "release_intent", "public_observation"] }, "minItems": 1, "uniqueItems": true },
        "minimum_items": { "type": "integer", "minimum": 1 },
        "provenance_required": { "const": true }
      },
      "additionalProperties": false
    },
    "severityPolicy": {
      "type": "object",
      "required": ["severity", "rationale"],
      "properties": {
        "severity": { "enum": ["critical", "major", "moderate"] },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "releaseGatePolicy": {
      "type": "object",
      "required": ["gate", "unverified_blocks_launch_ready"],
      "properties": {
        "gate": { "enum": ["always", "policy", "never"] },
        "unverified_blocks_launch_ready": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "freshnessBehavior": {
      "type": "object",
      "required": ["mode", "invalidated_by"],
      "properties": {
        "mode": { "enum": ["content_bound", "release_intent_bound", "live_state"] },
        "max_age_seconds": { "type": "integer", "minimum": 1 },
        "invalidated_by": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 }
      },
      "additionalProperties": false
    },
    "domainCoverage": {
      "type": "object",
      "required": ["risk_domain", "check_ids", "statuses"],
      "properties": {
        "risk_domain": { "$ref": "#/$defs/riskDomain" },
        "check_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "statuses": { "type": "array", "items": { "enum": ["passed", "failed", "unverified", "not_applicable"] }, "minItems": 1, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  },
  "x-launchrally-status": "initial-audit"
}
