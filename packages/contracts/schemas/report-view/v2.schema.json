{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://launchrally.dev/report-view/v2",
  "title": "LaunchRally Markdown Report View v2",
  "type": "object",
  "required": ["schema_version", "report_id", "report_schema_version", "generated_at", "format", "content"],
  "properties": {
    "schema_version": { "const": "launchrally.dev/report-view/v2" },
    "report_id": { "type": "string", "minLength": 1 },
    "report_schema_version": { "const": "launchrally.dev/report/v2" },
    "generated_at": { "type": "string", "format": "date-time" },
    "format": { "const": "markdown" },
    "content": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
