{
  "name": "launchrally",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "launchrally",
      "version": "0.1.0",
      "workspaces": [
        "packages/*",
        "adapters/*/launchrally"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "adapters/claude/launchrally": {
      "name": "@launchrally/claude-plugin",
      "version": "0.1.0"
    },
    "adapters/codex/launchrally": {
      "name": "@launchrally/codex-plugin",
      "version": "0.1.0"
    },
    "node_modules/@launchrally/claude-plugin": {
      "resolved": "adapters/claude/launchrally",
      "link": true
    },
    "node_modules/@launchrally/cli": {
      "resolved": "packages/cli",
      "link": true
    },
    "node_modules/@launchrally/codex-plugin": {
      "resolved": "adapters/codex/launchrally",
      "link": true
    },
    "node_modules/@launchrally/contracts": {
      "resolved": "packages/contracts",
      "link": true
    },
    "node_modules/@launchrally/core": {
      "resolved": "packages/core",
      "link": true
    },
    "packages/cli": {
      "name": "@launchrally/cli",
      "version": "0.1.0",
      "dependencies": {
        "@launchrally/contracts": "0.1.0",
        "@launchrally/core": "0.1.0"
      },
      "bin": {
        "rally": "bin/rally.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/contracts": {
      "name": "@launchrally/contracts",
      "version": "0.1.0"
    },
    "packages/core": {
      "name": "@launchrally/core",
      "version": "0.1.0",
      "dependencies": {
        "@launchrally/contracts": "0.1.0"
      }
    }
  }
}
